<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="PJ Media House — creative media, content and production.">
  <meta name="theme-color" content="#090909">
  <title>PJ Media House | Creative, Captured.</title>
  <style>
    :root {
      --bg: #090909;
      --panel: #11110f;
      --gold: #d6b36a;
      --gold-light: #f0d99d;
      --text: #f5f1e8;
      --muted: #aaa49a;
      --line: rgba(214,179,106,.23);
      --serif: Georgia, "Times New Roman", serif;
      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans);
      line-height: 1.6; overflow-x: hidden;
    }
    body::before {
      content: ""; position: fixed; inset: 0; pointer-events: none; z-index: -1;
      background: radial-gradient(ellipse at 78% 12%, rgba(174,132,55,.10), transparent 34%),
                  radial-gradient(ellipse at 12% 70%, rgba(174,132,55,.055), transparent 38%);
    }
    a { color: inherit; text-decoration: none; }
    button, input, textarea { font: inherit; }
    .wrap { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
    .topbar {
      position: sticky; top: 0; z-index: 20; background: rgba(9,9,9,.82);
      backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255,255,255,.07);
    }
    nav { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { display: flex; align-items: center; gap: 12px; letter-spacing: .12em; font-size: .82rem; font-weight: 700; }
    .brand-logo { width: 58px; height: 58px; object-fit: cover; border: 1px solid var(--line); border-radius: 50%; }\n    .brand-mark {
      width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--gold);
      color: var(--gold); font-family: var(--serif); font-size: 1.1rem; transform: rotate(45deg);
    }
    .brand-mark span { transform: rotate(-45deg); }
    .nav-links { display: flex; align-items: center; gap: 30px; color: #d0cbc1; font-size: .86rem; }
    .nav-links a { transition: color .25s ease; }
    .nav-links a:hover { color: var(--gold-light); }
    .nav-cta, .btn {
      display: inline-flex; justify-content: center; align-items: center; gap: 10px;
      border: 1px solid var(--gold); padding: 12px 20px; color: #090909;
      background: linear-gradient(120deg, var(--gold-light), var(--gold)); font-weight: 700;
      letter-spacing: .04em; font-size: .78rem; text-transform: uppercase;
      transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
    }
    .nav-cta:hover, .btn:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(214,179,106,.18); }
    .menu-toggle { display: none; background: none; border: 1px solid var(--line); color: var(--gold); padding: 8px 11px; }
    .hero { min-height: 690px; display: grid; align-items: center; position: relative; padding: 100px 0 110px; }
    .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 60px; }
    .eyebrow { color: var(--gold); text-transform: uppercase; letter-spacing: .22em; font-size: .72rem; font-weight: 700; }
    h1, h2, h3 { margin: 0; line-height: 1.08; }
    h1 { font: 500 clamp(3.4rem, 7.2vw, 6.6rem)/.98 var(--serif); letter-spacing: -.045em; margin: 22px 0 26px; }
    h1 em { color: var(--gold); font-weight: 400; }
    .hero-copy { color: var(--muted); max-width: 510px; font-size: 1.02rem; margin: 0 0 34px; }
    .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; }
    .text-link { color: var(--gold-light); font-size: .83rem; border-bottom: 1px solid var(--line); padding-bottom: 5px; }
    .visual {
      min-height: 450px; position: relative; border: 1px solid var(--line);
      background: linear-gradient(145deg, rgba(214,179,106,.15), transparent 38%),
                  linear-gradient(35deg, #171510, #090909 65%);
      display: grid; place-items: center; overflow: hidden;
    }
    .visual-inner { position: relative; z-index: 1; text-align: center; padding: 35px; }
    .monogram { font: 400 clamp(6rem, 14vw, 10rem)/1 var(--serif); color: var(--gold); letter-spacing: -.12em; text-shadow: 0 0 55px rgba(214,179,106,.2); }
    .visual-caption { letter-spacing: .3em; text-transform: uppercase; color: #d2c4a6; font-size: .65rem; margin-top: 16px; }
    .scroll-note { position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); color: #817b70; font-size: .65rem; letter-spacing: .2em; text-transform: uppercase; }
    .scroll-note::after { display: none; content: none; }
    section { padding: 110px 0; }
    .section-head { max-width: 650px; margin-bottom: 48px; }
    h2 { font: 400 clamp(2.5rem, 5vw, 4.3rem)/1.05 var(--serif); letter-spacing: -.035em; margin-top: 14px; }
    h2 em { color: var(--gold); font-weight: 400; }
    .section-intro { color: var(--muted); max-width: 580px; margin: 18px 0 0; }
    .about-grid { display: grid; grid-template-columns: 1fr; gap: 0; align-items: start; }
    .about-stamp { border: 1px solid var(--line); min-height: 260px; display: grid; place-items: center; background: linear-gradient(145deg, #17150f, #0b0b0a); }
    .about-stamp span { font: 400 5rem var(--serif); color: var(--gold); }
    .about-copy p { color: var(--muted); margin: 0 0 18px; }
    .services { background: #0e0e0c; border-block: 1px solid rgba(255,255,255,.06); }
    .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .service-card { padding: 30px; min-height: 235px; border: 1px solid var(--line); background: linear-gradient(145deg, rgba(214,179,106,.055), transparent 65%); transition: transform .3s ease, border-color .3s ease, background .3s ease; }
    .service-card:hover { transform: translateY(-7px); border-color: rgba(214,179,106,.65); background: linear-gradient(145deg, rgba(214,179,106,.12), transparent 75%); }
    .service-number { color: var(--gold); font: 1rem var(--serif); }
    .service-card h3 { font: 400 1.55rem var(--serif); margin: 30px 0 12px; }
    .service-card p { color: var(--muted); font-size: .9rem; margin: 0; }
    .portfolio-note { border: 1px dashed rgba(214,179,106,.35); padding: 46px; text-align: center; color: var(--muted); }
    .portfolio-note strong { color: var(--gold-light); display: block; font: 400 1.8rem var(--serif); margin-bottom: 8px; }
    .contact-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 80px; }
    .contact-details { color: var(--muted); }
    .contact-details p { max-width: 340px; }
    .contact-detail { margin-top: 28px; }
    .contact-detail small { display: block; color: var(--gold); text-transform: uppercase; letter-spacing: .15em; font-size: .65rem; margin-bottom: 5px; }
    form { display: grid; gap: 18px; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    label { display: block; color: #d7d0c4; font-size: .78rem; margin-bottom: 8px; }
    input, textarea {
      width: 100%; background: #11110f; border: 1px solid rgba(214,179,106,.22); color: var(--text);
      padding: 14px 15px; outline: none; transition: border-color .2s ease, box-shadow .2s ease;
    }
    input:focus, textarea:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(214,179,106,.08); }
    textarea { min-height: 145px; resize: vertical; }
    .form-help { color: #8e887e; font-size: .72rem; margin: -4px 0 0; }
    .form-status { min-height: 22px; color: var(--gold-light); font-size: .85rem; }
    footer { border-top: 1px solid rgba(255,255,255,.08); padding: 28px 0; color: #898378; font-size: .75rem; }
    .footer-row { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .gold { color: var(--gold); }
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    @keyframes orbit { to { transform: rotate(360deg); } }
    @keyframes pulse { 0%,100% { opacity: .35; transform: scaleY(.7); transform-origin: top; } 50% { opacity: 1; transform: scaleY(1); } }
    @keyframes arrowBounce { 0%,100% { opacity: .55; transform: translateY(0); } 50% { opacity: 1; transform: translateY(7px); } }
    @media (max-width: 820px) {
      .hero-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 42px; }
      .hero { padding-top: 75px; min-height: auto; }
      .visual { min-height: 340px; }
      .service-grid { grid-template-columns: 1fr 1fr; }
      .about-stamp { min-height: 190px; }
      section { padding: 82px 0; }
      .contact-grid { gap: 35px; }
    }
    @media (max-width: 620px) {
      .wrap { width: min(100% - 34px, 1160px); }
      nav { min-height: 68px; }
      .menu-toggle { display: inline-block; }
      .nav-cta { display: none; }
      .nav-links { display: none; position: absolute; top: 68px; left: 0; right: 0; padding: 20px 24px 24px; background: #0c0c0b; border-bottom: 1px solid var(--line); flex-direction: column; align-items: flex-start; gap: 18px; }
      .nav-links.open { display: flex; }
      h1 { font-size: clamp(3.25rem, 16vw, 5rem); }
      .service-grid, .field-row { grid-template-columns: 1fr; }
      .service-card { min-height: 205px; }
      .portfolio-note { padding: 32px 20px; }
      .visual { min-height: 290px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="wrap">
      <nav aria-label="Main navigation">
        <a class="brand" href="#home" aria-label="PJ Media House home">
          <img class="brand-logo" src="data:image/png;base64," alt="PJ Media House logo">
        </a>
        <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="navLinks">Menu</button>
        <div class="nav-links" id="navLinks">
          <a href="#about">About</a><a href="#services">Services</a><a href="#work">Our Work</a><a href="#contact">Contact</a>
        </div>
        <a class="nav-cta" href="#contact">Let's Talk <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="wrap hero-grid">
        <div class="reveal">
          <div class="eyebrow">Creative vision. Lasting impact.</div>
          <h1>Make your<br>moment <em>matter.</em></h1>
          <p class="hero-copy">Welcome to PJ Media House — a creative space for ideas, stories and visuals that deserve to stand out. Let's create something memorable.</p>
          <div class="hero-actions">
            <a class="btn" href="#contact">Start a project <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#services">Explore what we do</a>
          </div>
        </div>
        <div class="visual reveal" aria-label="PJ Media House monogram artwork">
          <img src="data:image/png;base64," alt="PJ gold monogram logo" style="width:100%;height:100%;position:absolute;inset:0;object-fit:cover;opacity:1;">
        </div>
      </div>
      <div class="scroll-note">Scroll to explore</div>
    </section>

    <section id="about">
      <div class="wrap about-grid">
        <div class="about-copy reveal">
          <div class="eyebrow">A little about us</div>
          <h2>Good stories deserve<br><em>great visuals.</em></h2>
          <p>PJ Media House is built around creativity, thoughtful storytelling and the details that make a project feel distinctive.</p>
          <p>Whether you're starting with a clear vision or just an idea, we're here to help bring it to life with care and purpose.</p>
          <a class="text-link" href="#contact">Tell us what you're imagining ↗</a>
        </div>
      </div>
    </section>

    <section class="services" id="services">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="eyebrow">What we do</div>
          <h2>Creative work,<br><em>made with purpose.</em></h2>
          <p class="section-intro">A few ways PJ Media House can help shape and share your story. Update these service descriptions to match your exact offerings.</p>
        </div>
        <div class="service-grid">
          <article class="service-card reveal"><div class="service-number">01 /</div><h3>Content Creation</h3><p>Creative content designed to communicate your message and connect with your audience.</p></article>
          <article class="service-card reveal"><div class="service-number">02 /</div><h3>Photo & Video</h3><p>Visual storytelling that captures the moments, people and ideas behind your brand.</p></article>
          <article class="service-card reveal"><div class="service-number">03 /</div><h3>Creative Projects</h3><p>Collaborative creative support to help turn a concept into something people remember.</p></article>
        </div>
      </div>
    </section>

    <section id="work">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="eyebrow">Selected work</div>
          <h2>A place for your<br><em>best work.</em></h2>
          <p class="section-intro">Your projects will look right at home here. Add your own photos, videos and case studies when you're ready.</p>
        </div>
        <div class="portfolio-note reveal"><strong>Your portfolio starts here.</strong>Replace this area with project images, client work or a showreel.</div>
      </div>
    </section>

    <section id="contact">
      <div class="wrap contact-grid">
        <div class="contact-details reveal">
          <div class="eyebrow">Get in touch</div>
          <h2>Let's make<br><em>something happen.</em></h2>
          <p>Have a project in mind, a question, or just want to say hello? Send a message and let's start the conversation.</p>
          <div class="contact-detail"><small>Enquiries</small><span>Use the contact form and we'll be in touch.</span></div>
        </div>
        <div class="reveal">
          <form id="contactForm" action="https://formsubmit.co/parvjani07@gmail.com" method="POST">
            <input type="hidden" name="_subject" value="New enquiry — PJ Media House">
            <input type="hidden" name="_template" value="table">
            <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
            <div class="field-row">
              <div><label for="name">Your name</label><input id="name" name="name" type="text" placeholder="Jane Smith" autocomplete="name" required></div>
              <div><label for="email">Email address</label><input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required></div>
            </div>
            <div><label for="subject">Subject</label><input id="subject" name="subject" type="text" placeholder="What can we help with?" required></div>
            <div><label for="message">Your message</label><textarea id="message" name="message" placeholder="Tell us a little about your project..." required></textarea></div>
            <button class="btn" type="submit">Send message <span aria-hidden="true">↗</span></button>
            <p class="form-help">The first time you receive an enquiry, FormSubmit will ask you to verify this email address. Check your inbox and confirm to activate the form.</p>
            <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-row">
      <span>© <span id="year"></span> <span class="gold">PJ Media House</span>. All rights reserved.</span>
      <span>Creative vision. Lasting impact.</span>
    </div>
  </footer>

  <script>
    // Reveal sections as they enter the screen.
    const revealItems = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealItems.forEach(item => observer.observe(item));
    } else {
      revealItems.forEach(item => item.classList.add('visible'));
    }

    // Mobile navigation.
    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');
    menuToggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
    });
    navLinks.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      navLinks.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
    }));

    document.getElementById('year').textContent = new Date().getFullYear();

  </script>
</body>
</html>
